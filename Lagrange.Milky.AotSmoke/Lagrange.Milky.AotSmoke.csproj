<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PublishAot>true</PublishAot>
    <InvariantGlobalization>true</InvariantGlobalization>
    <JsonSerializerIsReflectionEnabledByDefault>true</JsonSerializerIsReflectionEnabledByDefault>
  </PropertyGroup>
  <PropertyGroup Condition="'$(ReproduceUncachedBinding)' == 'true'">
    <DefineConstants>$(DefineConstants);REPRODUCE_UNCACHED_BINDING</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <TrimmerRootDescriptor Include="../Lagrange.Milky/Mcp/TrimmerRoots.xml" />
    <ProjectReference Include="../Lagrange.Milky/Lagrange.Milky.csproj" />
  </ItemGroup>
</Project>
